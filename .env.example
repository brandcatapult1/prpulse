# Cloud deployment — dev runs on Render (pr-pulse1, main branch),
# production runs on Hostinger (production branch). Set these in the
# respective host's environment (Render dashboard / Hostinger .env).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=generate-a-long-random-string
APP_URL=https://prpulse-1.onrender.com
# Google OAuth — add when ready for production (dev mode works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudinary — proof screenshot uploads (server-side only; never expose API secret to the client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload folder prefix on the shared Cloudinary account (default dev — set prod on Hostinger)
CLOUDINARY_FOLDER=dev
# Demo fixtures seed guard (must be true only in approved dev environments)
ALLOW_DEMO_SEED=false
# Exact dev database hostnames permitted for demo seed (comma-separated; unset = localhost only)
DEV_DB_HOSTS=ep-plain-fog-aib0a5ih-pooler.c-4.us-east-1.aws.neon.tech
# Set to false to require Google even when credentials are missing
DEV_AUTH=true
# Creator stats sync (optional — without these, stats show only what was last fetched)
# Instagram: Meta Graph Business Discovery via one of our own IG Business accounts
META_ACCESS_TOKEN=
META_IG_USER_ID=
